# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local backup files (auto-generated by patch scripts)
*.bak*

# patch scripts (临时开发工具)
patch_*.py

# local patch backups
.dev-backups/
*.bak
*.bak-*
*.broken
*.broken-*

# 样式备份不入库
src/app/_styles/*.bak-*
src/app/_styles/*.broken-*
*.bak2

# Capacitor iOS
ios/App/Pods/
ios/App/App/public/
ios/App/build/
ios/App/output/
ios/.gitkeep
DerivedData/
*.xcuserstate
xcuserdata/
