{
  "crons": [
    {
      "path": "/api/push/cron?slot=morning",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/push/cron?slot=noon",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/push/cron?slot=evening",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/push/cron?slot=night",
      "schedule": "0 5 * * *"
    }
  ]
}
